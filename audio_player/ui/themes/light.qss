/* ============================================================
   VB Player — Light Theme (Pure White + System Accent)
   Placeholder @ACCENT@ / @ACCENT_LIGHT@ / @ACCENT_DARK@ replaced at runtime
   ============================================================ */

QWidget#centralWidget { background: #ffffff; }
QWidget#centerPanel { background: #ffffff; }
QWidget#sidePanel { background: #f5f5f5; border-right: 1px solid #e0e0e0; }
QWidget#rightPanel { background: #f5f5f5; border-left: 1px solid #e0e0e0; }
QWidget#titleBar { background: transparent; }
QWidget#titleLabel { color: #888888; font-size: 12px; }

QPushButton#minBtn, QPushButton#maxBtn {
    background: transparent; border: none; border-radius: 0;
    color: #999999; font-size: 14px; padding: 0;
}
QPushButton#minBtn:hover, QPushButton#maxBtn:hover { background: #e0e0e0; color: #333333; }
QPushButton#closeBtn:hover { background: #e81123; color: #ffffff; }

QStatusBar { background: #fafafa; color: #999999; border-top: 1px solid #e0e0e0; font-size: 10px; padding: 1px 8px; }

QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #cccccc; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #aaaaaa; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 6px; }
QScrollBar::handle:horizontal { background: #cccccc; border-radius: 3px; min-width: 30px; }

QToolTip { background: #ffffff; color: #333333; border: 1px solid #d0d0d0; border-radius: 4px; padding: 4px 8px; font-size: 11px; }

QSplitter::handle { background: #e0e0e0; width: 1px; }

QStackedWidget { background: #ffffff; }
QWidget#playlistPage, QWidget#albumPage, QWidget#managePage { background: #ffffff; }

QLineEdit { background: #ffffff; color: #333333; border: 1px solid #d0d0d0; border-radius: 5px; padding: 5px 10px; }
QLineEdit:focus { border-color: @ACCENT@; }

QPushButton { background: #f0f0f0; color: #333333; border: 1px solid #d0d0d0; border-radius: 5px; padding: 5px 12px; }
QPushButton:hover { background: #e4e4e4; }
QPushButton:pressed { background: #d8d8d8; }

QComboBox { background: #ffffff; color: #333333; border: 1px solid #d0d0d0; border-radius: 5px; padding: 5px 10px; }
QComboBox:hover { border-color: #aaaaaa; }
QComboBox QAbstractItemView { background: #ffffff; color: #333333; border: 1px solid #d0d0d0; selection-background-color: #e8e8e8; }

QGroupBox { color: #888888; font-size: 11px; border: 1px solid #e0e0e0; border-radius: 5px; margin-top: 12px; padding-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }

QTabWidget::pane { background: #ffffff; border: 1px solid #e0e0e0; }
QTabBar::tab { color: #999999; padding: 10px 16px; border: none; min-width: 70px; }
QTabBar::tab:selected { color: #333333; background: #f5f5f5; }
QTabBar::tab:hover { color: #666666; }

QCheckBox { color: #333333; spacing: 8px; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 3px; border: 2px solid #cccccc; background: #ffffff; }
QCheckBox::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; }

QSlider::groove:horizontal { background: #e0e0e0; height: 3px; border-radius: 1px; }
QSlider::sub-page:horizontal { background: @ACCENT@; border-radius: 1px; }
QSlider::handle:horizontal { background: @ACCENT_DARK@; width: 12px; height: 12px; border-radius: 6px; margin: -5px 0; }
QSlider::groove:vertical { background: #e0e0e0; width: 3px; border-radius: 1px; }
QSlider::sub-page:vertical { background: @ACCENT@; border-radius: 1px; }
QSlider::handle:vertical { background: @ACCENT_DARK@; height: 12px; width: 12px; border-radius: 6px; margin: 0 -5px; }

QWidget#slidePanel { background: #f5f5f5; border-left: 1px solid #e0e0e0; }
QFrame#albumCard { background: #fafafa; border: 1px solid #e0e0e0; border-radius: 8px; }
QFrame#albumCard:hover { background: #f0f0f0; border-color: #ccc; }

/* ---- Labels ---- */
QLabel { color: #333333; font-size: 12px; }

/* Page title headers */
QLabel#pageTitle { color: #666666; font-size: 12px; font-weight: bold; letter-spacing: 2px; padding: 6px 12px; }

/* Manage page */
QWidget#managePage QLabel { color: #666666; font-size: 12px; }
QLabel#pageTitle { color: #333333; font-size: 15px; font-weight: bold; }

/* Sidebar */
QWidget#sidePanel QLabel#statsLabel { color: #888888; font-size: 12px; padding: 4px 10px; }
QFrame#sidebarSeparator { background: #d0d0d0; max-height: 1px; margin: 4px 8px; }
QPushButton#sidebarToggle { background: transparent; color: #555555; border: none; font-size: 20px; border-radius: 6px; }
QPushButton#sidebarToggle:hover { background: #e0e0e0; color: #333; }

/* Sidebar nav buttons */
QPushButton#navBtn { background: transparent; border: none; border-radius: 8px; font-size: 18px; }
QPushButton#navBtn:hover { background: #e8e8e8; }
QPushButton#navBtn[current="true"] { background: @ACCENT_DARKER@; }
QPushButton#navBtn[current="true"]:hover { background: @ACCENT_DARK@; }

/* Sidebar nav labels */
QLabel#navLabel { color: #555555; font-size: 14px; }
QLabel#navLabel[current="true"] { color: #333333; }

/* Sidebar reload button (accent) */
QPushButton#sidebarReloadBtn { background: @ACCENT@; color: #fff; border: none; border-radius: 5px; padding: 8px; font-size: 13px; margin: 4px 6px; }
QPushButton#sidebarReloadBtn:hover { background: @ACCENT_LIGHT@; }

/* Sidebar log box */
QTextEdit#sidebarLog { background: #f5f5f5; color: #555555; border: 1px solid #d0d0d0; border-radius: 4px; font-size: 10px; font-family: monospace; padding: 4px; }

/* Detail pages */
QLabel#detailName { color: #333333; font-size: 20px; font-weight: bold; }
QLabel#detailArtist { color: @ACCENT@; font-size: 14px; }
QLabel#detailDesc { color: #888888; font-size: 12px; }
QLabel#sectionLabel { color: #888888; font-size: 10px; font-weight: bold; letter-spacing: 2px; }
QLabel#metaChip { background: #f0f0f0; color: #666666; font-size: 10px; padding: 3px 8px; border-radius: 3px; }

/* Detail page buttons */
QWidget#albumDetailPage QPushButton,
QWidget#playlistDetailPage QPushButton { background: transparent; color: #666666; border: none; font-size: 12px; padding: 6px 12px; border-radius: 4px; }
QWidget#albumDetailPage QPushButton:hover,
QWidget#playlistDetailPage QPushButton:hover { background: #e0e0e0; color: #333; }

/* View toggle buttons */
QPushButton#viewToggle { background: #e0e0e0; color: #666666; border: none; border-radius: 5px; font-size: 13px; }
QPushButton#viewToggle:hover { background: #d0d0d0; color: #333333; }

/* Accent buttons */
QPushButton[accent="true"] { background: @ACCENT@; color: #ffffff; border: none; border-radius: 5px; padding: 8px; font-size: 13px; }
QPushButton[accent="true"]:hover { background: @ACCENT_LIGHT@; }

/* Menu */
QMenu { background: #ffffff; color: #333333; border: 1px solid #d0d0d0; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 14px; border-radius: 3px; }
QMenu::item:selected { background: @ACCENT@22; }
QMenu::separator { height: 1px; background: #e0e0e0; margin: 4px 8px; }

/* Text edit */
QTextEdit { background: #f5f5f5; color: #555555; border: 1px solid #d0d0d0; border-radius: 4px; font-size: 10px; font-family: monospace; padding: 4px; }

/* Fullscreen lyrics */
QWidget#fullscreenLyrics { background: #0a0a0f; }
QPushButton#fullscreenCloseBtn { background: #1a1a2e; color: #888; border: none; border-radius: 18px; font-size: 16px; }
QPushButton#fullscreenCloseBtn:hover { background: #2a2a4a; color: #fff; }
QLabel#fullscreenSpecBar { color: #444; font-size: 11px; font-family: monospace; background: transparent; padding: 8px; }

/* Output spec bar */
QLabel#specLabel { color: #555555; font-size: 10px; font-family: monospace; padding: 2px 10px; border-radius: 4px; background: transparent; }
QLabel#specLabel:hover { color: #333333; background: #e8e8e8; }

/* Output detail dialog */
QWidget#outputDetailBar { background: #f0f0f0; }
QWidget#outputDetailBody { background: #ffffff; }
QGroupBox#outputGroup { color: #666666; font-size: 11px; font-weight: bold; border: 1px solid #e0e0e0; border-radius: 6px; margin-top: 12px; padding-top: 18px; }
QGroupBox#outputGroup::title { subcontrol-origin: margin; left: 12px; }
QLabel#outputLabel { color: #666666; font-size: 11px; }
QLabel#outputValue { color: #333333; font-size: 12px; font-weight: bold; }

/* Settings */
QWidget#settingsDragBar { background: #fafafa; }
QLabel#settingsDragLabel { color: #666666; font-size: 13px; font-weight: 500; }

/* Empty state */
QLabel#emptyState { color: #888888; font-size: 13px; }

/* Dialog */
QDialog { background: #ffffff; border: 1px solid #e0e0e0; border-radius: 12px; }
QDialog QLabel#dialogTitle { color: #333333; font-size: 16px; font-weight: bold; }
QDialog QLabel#dialogSubLabel { color: #666666; font-size: 11px; }
QDialog QLineEdit { background: #f8f8f8; color: #333333; border: 1px solid #d0d0d0; border-radius: 6px; padding: 8px 10px; font-size: 13px; }
QDialog QLineEdit:focus { border: 1px solid @ACCENT@; }
QDialog QTextEdit { background: #f8f8f8; color: #333333; border: 1px solid #d0d0d0; border-radius: 6px; padding: 8px 10px; font-size: 12px; }
QDialog QTextEdit:focus { border: 1px solid @ACCENT@; }

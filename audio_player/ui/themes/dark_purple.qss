/* ============================================================
   VB Player — Dark Theme (Adwaita-dark palette — blends with GNOME)
   ============================================================ */

/* Base palette: GNOME Adwaita-dark inspired */
QWidget#centerPanel { background: #242424; }
QWidget#sidePanel { background: #1e1e1e; border-right: 1px solid #303030; }
QWidget#rightPanel { background: #1e1e1e; border-left: 1px solid #303030; }
QWidget#titleBar { background: transparent; }
QWidget#titleLabel { color: #999999; font-size: 12px; }

QPushButton#minBtn, QPushButton#maxBtn, QPushButton#closeBtn {
    background: transparent; border: none; border-radius: 0;
    color: #999; font-size: 14px; padding: 0;
}
QPushButton#minBtn:hover, QPushButton#maxBtn:hover { background: #363636; color: #fff; }
QPushButton#closeBtn:hover { background: #c01c28; color: #ffffff; }

QStatusBar { background: #242424; color: #777; border-top: 1px solid #303030; font-size: 10px; padding: 1px 8px; }

QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #444; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #555; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 6px; }
QScrollBar::handle:horizontal { background: #444; border-radius: 3px; min-width: 30px; }

QToolTip { background: #363636; color: #eee; border: 1px solid #444; border-radius: 6px; padding: 4px 10px; font-size: 11px; }

QSplitter::handle { background: #303030; width: 1px; }
QSplitter::handle:hover { background: @ACCENT@; }

QLineEdit { background: #1e1e1e; color: #eee; border: 1px solid #303030; border-radius: 8px; padding: 5px 10px; }
QLineEdit:focus { border-color: @ACCENT@; }

QPushButton { background: #2d2d2d; color: #eee; border: 1px solid #333; border-radius: 8px; padding: 6px 14px; }
QPushButton:hover { background: #363636; }
QPushButton:pressed { background: #1e1e1e; }

QComboBox { background: #1e1e1e; color: #eee; border: 1px solid #303030; border-radius: 8px; padding: 5px 10px; }
QComboBox:hover { border-color: #444; }
QComboBox QAbstractItemView { background: #2d2d2d; color: #eee; border: 1px solid #303030; selection-background-color: @ACCENT_DARK@; }

QGroupBox { color: #999; font-size: 11px; border: 1px solid #303030; border-radius: 8px; margin-top: 12px; padding-top: 14px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }

QTabWidget::pane { background: #1e1e1e; border: 1px solid #303030; }
QTabBar::tab { color: #777; padding: 10px 16px; border: none; min-width: 70px; }
QTabBar::tab:selected { color: #eee; background: #303030; }
QTabBar::tab:hover { color: #bbb; }

QCheckBox { color: #eee; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 2px solid #444; background: #1e1e1e; }
QCheckBox::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; }

QSlider::groove:horizontal { background: #303030; height: 4px; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @ACCENT@; border-radius: 2px; }
QSlider::handle:horizontal { background: @ACCENT_LIGHT@; width: 14px; height: 14px; border-radius: 7px; margin: -5px 0; }
QSlider::groove:vertical { background: #303030; width: 4px; border-radius: 2px; }
QSlider::sub-page:vertical { background: @ACCENT@; border-radius: 2px; }
QSlider::handle:vertical { background: @ACCENT_LIGHT@; height: 14px; width: 14px; border-radius: 7px; margin: 0 -5px; }

/* Cards */
QFrame#albumCard { background: #2d2d2d; border: 1px solid #333; border-radius: 10px; }
QFrame#albumCard:hover { background: #363636; border-color: #444; }

/* ---- Labels ---- */
QLabel { color: #eee; font-size: 12px; }

QLabel#pageTitle { color: #bbb; font-size: 12px; font-weight: bold; letter-spacing: 2px; padding: 6px 12px; }

QWidget#managePage QLabel { color: #bbb; font-size: 12px; }
QLabel#pageTitle { color: #eee; font-size: 15px; font-weight: bold; }

/* Sidebar */
QWidget#sidePanel QLabel#statsLabel { color: #888; font-size: 12px; padding: 4px 10px; }
QFrame#sidebarSeparator { background: #303030; max-height: 1px; margin: 4px 8px; }
QPushButton#sidebarToggle { background: transparent; color: #bbb; border: none; font-size: 20px; border-radius: 6px; }
QPushButton#sidebarToggle:hover { background: #363636; color: #fff; }

QPushButton#navBtn { background: transparent; border: none; border-radius: 8px; font-size: 18px; }
QPushButton#navBtn:hover { background: #363636; }
QPushButton#navBtn[current="true"] { background: @ACCENT_DARKER@; }
QPushButton#navBtn[current="true"]:hover { background: @ACCENT_DARK@; }

QLabel#navLabel { color: #bbb; font-size: 14px; }
QLabel#navLabel[current="true"] { color: #eee; }

QPushButton#sidebarReloadBtn { background: @ACCENT@; color: #fff; border: none; border-radius: 8px; padding: 8px; font-size: 13px; margin: 4px 6px; }
QPushButton#sidebarReloadBtn:hover { background: @ACCENT_LIGHT@; }

QTextEdit#sidebarLog { background: #1a1a1a; color: #777; border: 1px solid #303030; border-radius: 6px; font-size: 10px; font-family: monospace; padding: 4px; }

/* Detail pages */
QLabel#detailName { color: #eee; font-size: 20px; font-weight: bold; }
QLabel#detailArtist { color: @ACCENT@; font-size: 14px; }
QLabel#detailDesc { color: #888; font-size: 12px; }
QLabel#sectionLabel { color: #888; font-size: 10px; font-weight: bold; letter-spacing: 2px; }
QLabel#metaChip { background: #363636; color: #bbb; font-size: 10px; padding: 3px 8px; border-radius: 4px; }

QWidget#albumDetailPage QPushButton,
QWidget#playlistDetailPage QPushButton { background: transparent; color: #bbb; border: none; font-size: 12px; padding: 6px 12px; border-radius: 6px; }
QWidget#albumDetailPage QPushButton:hover,
QWidget#playlistDetailPage QPushButton:hover { background: #363636; color: #fff; }

QPushButton#viewToggle, QPushButton#sortBtn { background: rgba(255,255,255,0.06); color: #94a3b8; border: none; border-radius: 8px; font-size: 14px; }
QPushButton#viewToggle:hover, QPushButton#sortBtn:hover { background: @ACCENT_DARKER@; color: #e2e8f0; }

QPushButton[accent="true"] { background: @ACCENT@; color: #ffffff; border: none; border-radius: 8px; padding: 8px; font-size: 13px; }
QPushButton[accent="true"]:hover { background: @ACCENT_LIGHT@; }

/* Menu */
QMenu { background: #2d2d2d; color: #eee; border: 1px solid #444; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 14px; border-radius: 4px; }
QMenu::item:selected { background: @ACCENT_DARK@; }
QMenu::separator { height: 1px; background: #444; margin: 4px 8px; }

QTextEdit { background: #1a1a1a; color: #999; border: 1px solid #303030; border-radius: 6px; font-size: 10px; font-family: monospace; padding: 4px; }

/* Fullscreen lyrics */
QWidget#fullscreenLyrics { background: #1a1a1a; }
QPushButton#fullscreenCloseBtn { background: #363636; color: #999; border: none; border-radius: 18px; font-size: 16px; }
QPushButton#fullscreenCloseBtn:hover { background: #444; color: #fff; }
QLabel#fullscreenSpecBar { color: #666; font-size: 11px; font-family: monospace; background: transparent; padding: 8px; }

/* Output spec bar */
QLabel#specLabel { color: #777; font-size: 10px; font-family: monospace; padding: 2px 10px; border-radius: 4px; background: transparent; }
QLabel#specLabel:hover { color: #ddd; background: #363636; }

QWidget#outputDetailBar { background: #1e1e1e; }
QWidget#outputDetailBody { background: #242424; }
QGroupBox#outputGroup { color: @ACCENT_LIGHT@; font-size: 11px; font-weight: bold; border: 1px solid @ACCENT@; border-radius: 8px; margin-top: 12px; padding-top: 18px; }
QGroupBox#outputGroup::title { subcontrol-origin: margin; left: 12px; }
QLabel#outputLabel { color: #888; font-size: 11px; }
QLabel#outputValue { color: #eee; font-size: 12px; font-weight: bold; }

QWidget#settingsDragBar { background: #242424; }
QLabel#settingsDragLabel { color: #bbb; font-size: 13px; font-weight: 500; }

QLabel#emptyState { color: #888; font-size: 13px; }

/* Dialog */
QDialog { background: #2d2d2d; border: 1px solid #444; border-radius: 12px; }
QDialog QLabel#dialogTitle { color: #eee; font-size: 16px; font-weight: bold; }
QDialog QLabel#dialogSubLabel { color: #bbb; font-size: 11px; }
QDialog QLineEdit { background: #1e1e1e; color: #eee; border: 1px solid #363636; border-radius: 8px; padding: 8px 10px; font-size: 13px; }
QDialog QLineEdit:focus { border: 1px solid @ACCENT@; }
QDialog QTextEdit { background: #1e1e1e; color: #eee; border: 1px solid #363636; border-radius: 8px; padding: 8px 10px; font-size: 12px; }
QDialog QTextEdit:focus { border: 1px solid @ACCENT@; }
